# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fidelidade?schema=public"

# Segredo para assinar as sessões (JWT). Gere com: openssl rand -base64 32
SESSION_SECRET=""

# URL pública do app (links/QR Codes e retornos do pagamento). Na Vercel pode ficar vazio: usa o domínio do deploy.
APP_URL="http://localhost:3000"

# Pagamento: "stripe" (produção) ou "mock" (somente desenvolvimento)
# "mock" só funciona em desenvolvimento e em previews da Vercel; em produção use "stripe"
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
# Endpoint: {APP_URL}/api/webhooks/stripe com os eventos checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid e invoice.payment_failed
STRIPE_WEBHOOK_SECRET=""
# ID do preço recorrente de R$ 197,00/mês criado no Stripe (price_...)
STRIPE_PRICE_ID=""

# E-mail (recuperação de senha). Dois jeitos, o SMTP tem prioridade:
#  1) SMTP, funciona SEM domínio próprio e entrega para qualquer pessoa. Ex. com Gmail: ative a verificação em duas etapas, crie uma
#     "senha de app" em myaccount.google.com/apppasswords e use host smtp.gmail.com, porta 465, usuário = o endereço Gmail.
#  2) Resend: sem domínio verificado só entrega para o e-mail dono da conta do Resend.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
# Remetente. No Gmail use o próprio endereço da conta, ex.: "Fidelize <voce@gmail.com>".
EMAIL_FROM="Fidelize <onboarding@resend.dev>"
# Suporte: o e-mail é o canal principal (aparece nos Termos, na Privacidade e nos avisos de erro); o WhatsApp complementa (DDI 55 + DDD + número, só dígitos).
SUPPORT_EMAIL=""
SUPPORT_WHATSAPP=""
# Opcional: dados da empresa que aparecem nos Termos e na Política (só mostra se LEGAL_NAME estiver preenchido).
LEGAL_NAME=""
LEGAL_CNPJ=""
# Busca de fotos de produtos: token gratuito da API Bluesoft Cosmos (cosmos.bluesoft.com.br → Minha conta → API).
# Sem ele a busca usa só o Open Food Facts e a foto pública da Bluesoft (quando o código é conhecido).
COSMOS_TOKEN=""

# Lembrete "está tudo certo?" antes do horário: a rota /api/cron/lembretes exige este segredo (mín. 16 caracteres).
# O GitHub Actions (.github/workflows/lembretes.yml) chama a rota a cada 5 min; cadastre o MESMO valor em Settings → Secrets → CRON_SECRET.
CRON_SECRET=

# Azulejos do mapa de localização do cliente (opcional). Padrão: OpenStreetMap, só para o piloto.
# Em produção use um provedor com plano próprio: https://.../{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILES=
