# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fidelidade?schema=public"

# Segredo para assinar as sessões (JWT). Gere com: openssl rand -base64 32
SESSION_SECRET=""

# URL pública do app (links/QR Codes e retornos do pagamento). Na Vercel pode ficar vazio: usa o domínio do deploy.
APP_URL="http://localhost:3000"

# Pagamento: "stripe" (produção) ou "mock" (somente desenvolvimento)
# "mock" só funciona em desenvolvimento e em previews da Vercel; em produção use "stripe"
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
# Endpoint: {APP_URL}/api/webhooks/stripe com os eventos checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid e invoice.payment_failed
STRIPE_WEBHOOK_SECRET=""
# ID do preço recorrente de R$ 197,00/mês criado no Stripe (price_...)
STRIPE_PRICE_ID=""

# E-mail (recuperação de senha). Resend: crie a conta, gere a chave e, com um domínio verificado, use um remetente do seu domínio.
# Sem domínio verificado o Resend só entrega para o e-mail do dono da conta (remetente padrão de teste).
RESEND_API_KEY=""
EMAIL_FROM="Fidelize <onboarding@resend.dev>"
# Busca de fotos de produtos: token gratuito da API Bluesoft Cosmos (cosmos.bluesoft.com.br → Minha conta → API).
# Sem ele a busca usa só o Open Food Facts e a foto pública da Bluesoft (quando o código é conhecido).
COSMOS_TOKEN=""
# WhatsApp do suporte (DDI 55 + DDD + número, só dígitos)
SUPPORT_WHATSAPP=""
