generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  PENDING // cadastrou, ainda não pagou
  ACTIVE // assinatura de R$ 197,00/mês paga e vigente
  PAST_DUE // cobrança falhou
  CANCELED
}

enum TransactionType {
  EARN
  REDEEM
  SHARED_OUT // pontos que saíram desta carteira para completar um resgate em outro lugar
  SHARED_IN // pontos equivalentes que entraram nesta carteira vindos de outro lugar
}

enum ChallengeKind {
  PURCHASES // N compras (opcionalmente com valor mínimo) no período
  CHECKINS // N check-ins (visitas no local) no período
}

enum ChallengePeriod {
  WEEK
  MONTH
}

enum ReferralStatus {
  PENDING // amigo se cadastrou pelo convite, ainda não fez a primeira compra
  REWARDED // amigo fez a primeira compra e quem indicou recebeu os pontos
}

enum RedemptionStatus {
  PENDING // voucher gerado pelo cliente, ainda não entregue pelo balcão
  USED // balcão validou e entregou o prêmio
}

enum OrderStatus {
  RECEIVED // o cliente fez o pedido, o lugar ainda não viu
  PREPARING
  READY // pronto para retirar
  PICKED_UP // retirado e pago no balcão (é aqui que os pontos entram)
  CANCELED
}

enum BookingStatus {
  PENDING // aguardando o estabelecimento confirmar (quando a confirmação é manual)
  CONFIRMED
  COMPLETED // atendimento feito; os pontos foram creditados
  CANCELED
  NO_SHOW // o cliente não compareceu
}

/// Restaurante = conta do SaaS (quem paga a assinatura).
model Restaurant {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  phone        String
  passwordHash String

  // Onboarding
  // address, openingSchedule, latitude, longitude e googleReviewUrl são LEGADO: hoje vivem em Unit (não use mais).
  address         String?
  /// Horário por dia da semana: [{ day: 0-6, closed, open: "HH:MM", close: "HH:MM" }] (ver src/lib/hours.ts)
  openingSchedule Json?
  onboardedAt     DateTime?
  guideDoneAt     DateTime? // passo a passo inicial concluído ou dispensado
  internalNote    String? // anotação interna da administração (o dono não vê)
  isTest          Boolean   @default(false) // conta de teste da administração: fora da receita e dos números de assinantes
  termsAcceptedAt DateTime? // aceite dos Termos de Uso e da Política de Privacidade (null = conta anterior ao aceite)
  termsVersion    String? // versão aceita (ver src/lib/legal.ts)

  // Assinatura
  subscriptionStatus    SubscriptionStatus @default(PENDING)
  paymentCustomerId     String?
  paymentSubscriptionId String?

  // Regras de pontuação
  pointsPerReal        Int     @default(10) // R$ 1,00 = 10 pontos
  maxRedeemsPerMonth   Int     @default(5) // limite de resgates por CPF por mês
  checkInPoints        Int     @default(1) // pontos por check-in no local (0 desliga)
  checkInRadiusM       Int     @default(10) // distância máxima (m) do ponto da unidade para o check-in valer; o cliente nunca vê esse número
  referralPoints       Int     @default(100) // pontos para quem indica um amigo que compra (0 desliga)
  birthdayPoints       Int     @default(0) // presente de pontos no aniversário do cliente (0 desliga)
  // Presente do aniversariante (um item ou benefício do lugar, resgatado com cupom no dia do aniversário do cliente)
  birthdayPerkOn       Boolean @default(false)
  birthdayPerkTitle    String? // ex.: "Sobremesa grátis"
  birthdayPerkMode     String  @default("FREE") // FREE (grátis), POINTS (troca por pontos) ou SPEND (ao consumir um valor mínimo)
  birthdayPerkPoints   Int     @default(0) // custo em pontos (modo POINTS)
  birthdayPerkMinCents Int     @default(0) // consumo mínimo em centavos (modo SPEND)

  // Agenda e reservas
  bookingAutoConfirm  Boolean @default(true) // false: o estabelecimento confirma cada pedido
  bookingMinNoticeMin Int     @default(60) // antecedência mínima para marcar, em minutos
  bookingMaxDaysAhead Int     @default(30) // até quantos dias à frente o cliente pode marcar
  bookingCancelHours  Int     @default(2) // o cliente cancela sozinho até X horas antes
  bookingBufferMin    Int     @default(0) // intervalo entre atendimentos (limpeza, troca de cliente), em minutos
  bookingSlotStepMin  Int     @default(0) // de quanto em quanto tempo os horários aparecem para o cliente: 0 = automático (do tamanho do serviço), ou 15, 30, 60 min
  reviewsSeenAt       DateTime @default(now()) // última vez que o dono abriu Avaliações: o que chegou depois é novidade no Início
  postsSeenAt         DateTime @default(now()) // idem, para Indicações
  pointsPerRealOff    Int     @default(100) // quantos pontos valem R$ 1,00 de desconto num serviço (padrão: ganha 10 por real, 100 pontos = R$ 1,00)
  bookingNotifyEmail  String? // e-mail que recebe cada novo agendamento (vazio = o e-mail da conta)

  // Pedidos pelo app (cardápio, sacola e retirada com pagamento no balcão). Começa desligado.
  ordersEnabled Boolean @default(false)
  orderPrepMin  Int     @default(15) // "pronto em X min", mostrado ao cliente

  // Pontos compartilhados entre lugares (ecossistema). Os dois começam desligados.
  pointsShareOut Boolean @default(false) // clientes podem usar em outros lugares os pontos ganhos aqui
  pointsAcceptIn Boolean @default(false) // aceita pontos que o cliente ganhou em outros lugares

  // Vitrine pública ("Lugares")
  listed          Boolean @default(true)
  category        String?
  categoryOther   String? // texto livre quando category = "outros" (ex.: doceria)
  instagram       String?
  googleReviewUrl String?
  latitude        Float?
  longitude       Float?
  logoImageId     String?
  coverImageId    String?
  brandColor      String? // chave de BRAND_COLORS (src/lib/palette.ts); vazio = marinho padrão
  tagline         String? // slogan curto, mostrado sob o nome na página do lugar
  about           String? // "Sobre nós", texto livre mostrado na página do lugar

  createdAt DateTime @default(now())

  interactionRules  InteractionRule[]
  rewards           Reward[]
  claims            Claim[]
  wallets           Wallet[]
  redemptions       Redemption[]
  units             Unit[]
  promotions        Promotion[]
  promotionUses     PromotionUse[]
  challenges        Challenge[]
  checkIns          CheckIn[]
  referrals         Referral[]
  images            Image[]
  resources         Resource[]
  services          Service[]
  bookings          Booking[]
  slotHolds         SlotHold[]
  waitlist          WaitlistEntry[]
  timeOffs          TimeOff[]
  posts             Post[]
  conversations     Conversation[]
  clubSubscriptions ClubSubscription[]
  reviews           Review[]
  menuItems         MenuItem[]
  orders            Order[]
  birthdayGifts     BirthdayGift[]
  interactionClaims InteractionClaim[]
  financeEntries    FinanceEntry[]
  commissionPayouts CommissionPayout[]
  clubPlans         ClubPlan[]
}

/// Pontuação fixa por interação (foto no Instagram, avaliação 5★ no Google...).
model InteractionRule {
  id           String   @id @default(uuid())
  restaurantId String
  label        String
  points       Int
  active       Boolean  @default(true)
  /// Como os pontos são confirmados: COUNTER (só no balcão, como sempre foi), MANUAL (o cliente toca "Já fiz" e o dono aprova)
  /// ou AUTO (o cliente toca "Já fiz" e os pontos entram sozinhos em 24 h, a menos que o dono recuse antes).
  approval     String   @default("COUNTER")
  createdAt    DateTime @default(now())

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  claims     InteractionClaim[]

  @@index([restaurantId])
}

enum InteractionClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

/// "Já fiz": pedido do cliente por pontos de uma interação (avaliar no Google, story no Instagram…), que o dono aprova ou recusa.
model InteractionClaim {
  id           String                 @id @default(uuid())
  restaurantId String
  customerId   String
  ruleId       String?
  label        String // snapshot da descrição
  points       Int // snapshot
  status       InteractionClaimStatus @default(PENDING)
  autoAt       DateTime? // quando entra sozinho (regra AUTO); vazio = só com aprovação do dono
  createdAt    DateTime               @default(now())
  decidedAt    DateTime?
  decidedBy    String? // OWNER ou AUTO

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rule       InteractionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status])
  @@index([customerId, ruleId, createdAt])
}

/// Produto do cardápio elegível para resgate com pontos.
model Reward {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  pointsCost   Int
  cashCents    Int      @default(0) // valor em R$ cobrado no balcão junto com os pontos (0 = só pontos)
  birthdayOnly Boolean  @default(false) // prêmio criado pelo "presente do aniversariante": fora das listas de prêmios, só resgatável no aniversário
  imageId      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  redemptions Redemption[]

  @@index([restaurantId])
}

model Customer {
  id              String    @id @default(uuid())
  cpf             String    @unique // somente dígitos
  phone           String // somente dígitos, sem +55
  name            String
  email           String?   @unique // minúsculo; null até o cliente criar o acesso com e-mail e senha
  passwordHash    String?
  referralCode    String?   @unique // código do link "Indique amigos"
  accountCode     String?   @unique // ID da conta (FZ-XXXXXX): o cliente informa no caixa no lugar do CPF
  termsAcceptedAt DateTime? // aceite dos Termos de Uso e da Política de Privacidade (null = conta anterior ao aceite)
  termsVersion    String? // versão aceita (ver src/lib/legal.ts)
  birthDay        Int? // aniversário: só dia e mês (sem o ano), opcional; o cliente informa e remove quando quiser
  birthMonth      Int?
  instagram       String? // @ do Instagram (sem o @), opcional: aparece nas indicações e abre o perfil
  createdAt       DateTime  @default(now())

  wallets           Wallet[]
  claims            Claim[]
  redemptions       Redemption[]
  checkIns          CheckIn[]
  completions       ChallengeCompletion[]
  referralsMade     Referral[]            @relation("referrer")
  referralsReceived Referral[]            @relation("referred")
  notifications     Notification[]
  addresses         CustomerAddress[]
  promotionUses     PromotionUse[]
  bookings          Booking[]
  slotHolds         SlotHold[]
  waitlist          WaitlistEntry[]
  reviews           Review[]
  photo             CustomerPhoto?
  orders            Order[]
  birthdayGifts     BirthdayGift[]
  interactionClaims InteractionClaim[]
  posts             Post[]
  postLikes         PostLike[]
  conversations     Conversation[]
  clubSubscriptions ClubSubscription[]
}

/// Foto de perfil do cliente. Fica em tabela própria para não pesar a consulta da sessão; só o próprio cliente a vê.
model CustomerPhoto {
  customerId String   @id
  mime       String
  data       Bytes
  updatedAt  DateTime @default(now()) @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

/// Uma carteira por cliente por restaurante.
model Wallet {
  id           String   @id @default(uuid())
  customerId   String
  restaurantId String
  balance      Int      @default(0)
  createdAt    DateTime @default(now())

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  redemptions  Redemption[]

  @@unique([customerId, restaurantId])
}

/// Pontos gerados pelo caixa e ainda não creditados. O token vai no QR Code / link.
/// Os pontos são calculados e gravados no servidor — nunca vêm da URL.
model Claim {
  id           String    @id @default(uuid())
  token        String    @unique
  restaurantId String
  amountCents  Int
  points       Int
  description  String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  redeemedAt   DateTime?
  customerId   String?
  unitId       String? // unidade onde o caixa lançou a compra
  billPoints   Int? // parte dos pontos que veio do valor da conta (base das campanhas)

  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id])
  unit        Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  transaction Transaction?
  booking     Booking?
  order       Order?

  @@index([restaurantId, createdAt])
}

model Transaction {
  id           String          @id @default(uuid())
  walletId     String
  type         TransactionType
  points       Int // sempre positivo; o sinal vem do type
  description  String
  claimId      String?         @unique // garante crédito único por QR Code
  redemptionId String?         @unique
  createdAt    DateTime        @default(now())

  wallet     Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  claim      Claim?      @relation(fields: [claimId], references: [id])
  redemption Redemption? @relation(fields: [redemptionId], references: [id])

  @@index([walletId, createdAt])
}

/// Troca de pontos por prêmio. O cliente apresenta o `code` no balcão.
model Redemption {
  id           String           @id @default(uuid())
  restaurantId String
  customerId   String
  walletId     String
  rewardId     String
  rewardName   String // snapshot, caso o prêmio seja editado depois
  pointsCost   Int // snapshot
  cashCents    Int              @default(0) // snapshot do valor em R$ a cobrar no balcão
  code         String
  status       RedemptionStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  usedAt       DateTime?
  usedUnitId   String? // unidade que entregou o prêmio

  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  usedUnit    Unit?        @relation("delivered", fields: [usedUnitId], references: [id], onDelete: SetNull)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  wallet      Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  reward      Reward       @relation(fields: [rewardId], references: [id])
  transaction Transaction?

  @@unique([restaurantId, code])
  @@index([customerId, restaurantId, createdAt])
}

/// Contador de tentativas por chave (ex.: "login:ip:1.2.3.4") para limitar força bruta.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

/// Foto (logo, capa, prêmio) guardada no próprio banco, já reduzida pelo navegador antes do envio.
model Image {
  id           String   @id @default(uuid())
  restaurantId String
  mime         String
  data         Bytes
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

/// Desafio da casa: bônus de pontos ao cumprir uma meta no período (semana ou mês).
model Challenge {
  id             String          @id @default(uuid())
  restaurantId   String
  title          String
  kind           ChallengeKind
  target         Int // quantidade (compras ou check-ins)
  minAmountCents Int             @default(0) // valor mínimo por compra (só PURCHASES)
  period         ChallengePeriod
  bonusPoints    Int
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())

  restaurant  Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  completions ChallengeCompletion[]

  @@index([restaurantId])
}

/// Um desafio só premia uma vez por cliente em cada período (periodKey = início da semana ou mês).
model ChallengeCompletion {
  id          String   @id @default(uuid())
  challengeId String
  customerId  String
  periodKey   String
  createdAt   DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([challengeId, customerId, periodKey])
}

/// Check-in por proximidade: no máximo um por dia por cliente em cada restaurante.
model CheckIn {
  id           String   @id @default(uuid())
  customerId   String
  restaurantId String
  dayKey       String // YYYY-MM-DD em Brasília
  distanceM    Int
  createdAt    DateTime @default(now())

  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  unit       Unit?      @relation(fields: [unitId], references: [id])
  unitId     String?

  @@unique([customerId, restaurantId, dayKey])
  @@index([restaurantId, createdAt])
}

model Referral {
  id           String         @id @default(uuid())
  restaurantId String
  referrerId   String
  referredId   String
  status       ReferralStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  rewardedAt   DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  referrer   Customer   @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred   Customer   @relation("referred", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, referredId])
  @@index([referrerId])
}

/// Unidade (filial) de uma marca. Cada unidade tem endereço, horário, localização e link do Google próprios.
/// Pontos, prêmios, desafios e carteiras são da marca e valem em qualquer unidade.
model Unit {
  id              String   @id @default(uuid())
  restaurantId    String
  name            String
  address         String? // texto final (montado de rua, número, complemento...); é o que o cliente vê
  cep             String? // só dígitos
  street          String?
  number          String?
  complement      String?
  district        String?
  city            String?
  state           String?
  openingSchedule Json?
  latitude        Float?
  longitude       Float?
  googleReviewUrl String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  claims     Claim[]
  checkIns   CheckIn[]
  deliveries Redemption[] @relation("delivered")
  resources  Resource[]
  bookings   Booking[]
  orders     Order[]

  waitlist WaitlistEntry[]

  @@index([restaurantId])
}

/// Avisos dentro do app do cliente (pontos, metas de prêmio, desafios, indicações).
/// Endereço salvo do cliente (Casa, Trabalho, Outro): a vitrine de lugares ordena por perto dele.
model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  label      String // CASA, TRABALHO ou OUTRO
  street     String
  number     String
  complement String?
  district   String?
  city       String
  state      String
  cep        String?
  latitude   Float
  longitude  Float
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Notification {
  id           String    @id @default(uuid())
  customerId   String
  restaurantId String?
  title        String
  body         String
  href         String? // para onde o aviso leva ao tocar
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

enum PromoKind {
  MULTIPLIER
  BONUS
}

/// Campanha de pontos criada pelo dono: multiplicador ("2x") ou pontos extras, por período, dia da semana e horário.
model Promotion {
  id             String        @id @default(uuid())
  restaurantId   String
  title          String
  kind           PromoKind
  multiplier     Float?
  bonusPoints    Int?
  minAmountCents Int           @default(0)
  startsAt       DateTime?
  endsAt         DateTime? // exclusivo
  weekdays       Int[] // 0 = domingo … 6 = sábado; vazio = todos os dias
  startTime      String? // "HH:MM" em Brasília
  endTime        String?
  audience       PromoAudience @default(ALL)
  inactiveDays   Int? // só para audience = INACTIVE
  active         Boolean       @default(true)
  appCampaignId  String? // preenchido quando o estabelecimento adotou uma campanha do app
  color          String? // chave da paleta (src/lib/palette.ts); vazio = cor padrão pelo público
  createdAt      DateTime      @default(now())

  restaurant  Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  appCampaign AppCampaign?   @relation(fields: [appCampaignId], references: [id], onDelete: SetNull)
  uses        PromotionUse[]

  @@unique([restaurantId, appCampaignId])
  @@index([restaurantId])
  @@index([appCampaignId])
}

/// Campanha proposta pela plataforma (ex.: pontos em dobro terça e quinta). Cada estabelecimento adota ou não.
model AppCampaign {
  id             String    @id @default(uuid())
  title          String
  description    String    @default("")
  kind           PromoKind
  multiplier     Float?
  bonusPoints    Int?
  minAmountCents Int       @default(0)
  weekdays       Int[]
  startTime      String?
  endTime        String?
  startsAt       DateTime?
  endsAt         DateTime? // exclusivo
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  promotions Promotion[]
}

enum PromoAudience {
  ALL // todos os clientes
  NEW // só a primeira compra do cliente no estabelecimento
  INACTIVE // quem já comprou, mas não volta há `inactiveDays` dias
}

/// Uma campanha aplicada numa compra creditada (base do relatório mensal).
model PromotionUse {
  id           String   @id @default(uuid())
  promotionId  String?
  restaurantId String
  title        String // cópia do nome: o histórico fica mesmo se a campanha for removida
  claimId      String
  customerId   String
  points       Int // pontos a mais que esta campanha rendeu
  amountCents  Int // valor da compra
  createdAt    DateTime @default(now())

  promotion  Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([claimId, promotionId])
  @@index([restaurantId, createdAt])
}

/// Administrador da plataforma (quem gerencia os assinantes). Entra em /admin, com sessão própria.
model AdminUser {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  passwordHash    String? // vazio até o convite ser aceito
  inviteTokenHash String?   @unique // sha256 do token do convite (o token em si nunca é guardado)
  inviteExpiresAt DateTime?
  active          Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())

  logs AdminLog[]
}

/// Registro de tudo que a administração faz nas contas dos assinantes.
model AdminLog {
  id             String   @id @default(uuid())
  adminId        String?
  adminEmail     String // cópia: o registro fica mesmo se o administrador for removido
  action         String
  restaurantId   String?
  restaurantName String?
  detail         String
  createdAt      DateTime @default(now())

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([restaurantId])
}

/// Link de redefinição de senha enviado por e-mail. kind = "customer" | "restaurant". Só o hash do token é guardado.
model PasswordReset {
  id        String    @id @default(uuid())
  kind      String
  subjectId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([kind, subjectId])
}

/// Profissional, cadeira ou mesa que atende. `capacity` = atendimentos ao mesmo tempo (1 para uma pessoa; várias para um salão de mesas).
model Resource {
  id           String   @id @default(uuid())
  restaurantId String
  unitId       String? // vazio = atende em todas as unidades
  name         String
  capacity     Int      @default(1)
  active       Boolean  @default(true)
  photoImageId String? // foto do profissional, para o cliente ver com quem vai ser atendido
  email        String? // recebe aviso de cada agendamento dele
  phone        String? // WhatsApp (só dígitos), para o gestor enviar a agenda
  /// Dias e horários em que trabalha, no mesmo formato do horário da unidade. Vazio = segue o horário da unidade.
  schedule     Json?
  color        String? // chave da paleta (src/lib/palette.ts); vazio = cor automática pela ordem
  commissionBp Int      @default(0) // comissão sobre os atendimentos concluídos, em centésimos de % (4000 = 40%)
  createdAt    DateTime @default(now())

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  unit       Unit?              @relation(fields: [unitId], references: [id], onDelete: SetNull)
  payouts    CommissionPayout[]
  services   Service[]
  bookings   Booking[]
  slotHolds  SlotHold[]
  waitlist   WaitlistEntry[]
  timeOffs   TimeOff[]
  reviews    Review[]
  offers     ResourceService[]

  @@index([restaurantId])
}

/// O que o cliente pode marcar: corte, limpeza de pele, reserva de mesa…
model Service {
  id                   String   @id @default(uuid())
  restaurantId         String
  resourceId           String? // se preenchido, só esse profissional/vaga atende
  name                 String
  description          String?
  durationMin          Int
  priceCents           Int      @default(0)
  askPartySize         Boolean  @default(false) // reserva de mesa: pergunta quantas pessoas
  pointsDiscountMaxPct Int      @default(0) // até quantos % do preço o cliente pode pagar com pontos (0 = não aceita)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  resource   Resource?         @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  bookings   Booking[]
  offers     ResourceService[]
  planItems  ClubPlanItem[]

  waitlist WaitlistEntry[]

  @@index([restaurantId])
}

/// Quais serviços cada profissional faz e quanto tempo leva com ele. Serviço sem nenhuma linha aqui é feito por qualquer profissional.
model ResourceService {
  id          String @id @default(uuid())
  resourceId  String
  serviceId   String
  durationMin Int? // vazio = a duração padrão do serviço

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, serviceId])
  @@index([serviceId])
}

/// Item do cardápio vendido em R$ pelo app (retirada). Diferente de Reward, que é o prêmio trocado por pontos.
model MenuItem {
  id              String    @id @default(uuid())
  restaurantId    String
  name            String
  description     String?
  priceCents      Int // preço cheio
  promoCents      Int? // preço promocional (o cheio aparece riscado); null = sem promoção
  category        String    @default("Cardápio")
  imageId         String?
  featured        Boolean   @default(false) // "Destaque da casa"
  active          Boolean   @default(true)
  // Oferta: o preço promocional só vale até `offerEndsAt` e enquanto houver `offerStock` (null = sem limite). `spotlight` mostra o cartão na lista de Lugares.
  spotlight       Boolean   @default(false)
  offerEndsAt     DateTime?
  offerStock      Int? // unidades que ainda saem pelo preço promocional
  offerStockTotal Int? // quantas eram no início (para o anel de progresso)
  createdAt       DateTime  @default(now())

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([restaurantId, active])
}

/// Pedido para retirada. O pagamento e a retirada acontecem no balcão; os pontos entram quando o lugar marca como retirado.
model Order {
  id            String      @id @default(uuid())
  restaurantId  String
  unitId        String?
  customerId    String
  code          String // o cliente mostra no balcão
  status        OrderStatus @default(RECEIVED)
  totalCents    Int
  prepMin       Int // "pronto em X min" prometido na hora
  note          String?
  pointsAwarded Int         @default(0)
  claimId       String?     @unique // lançamento que creditou os pontos (ao retirar)
  createdAt     DateTime    @default(now())
  readyAt       DateTime?
  pickedUpAt    DateTime?
  canceledAt    DateTime?
  canceledBy    String? // CUSTOMER ou OWNER

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  unit       Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  claim      Claim?      @relation(fields: [claimId], references: [id], onDelete: SetNull)
  items      OrderItem[]

  @@unique([restaurantId, code])
  @@index([restaurantId, status, createdAt])
  @@index([customerId, createdAt])
}

/// Cópia do que foi pedido: o histórico não muda se o item for editado ou removido do cardápio.
model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  menuItemId String?
  name       String
  unitCents  Int // o que foi cobrado por unidade
  listCents  Int // preço cheio (para mostrar o riscado)
  qty        Int
  imageId    String?

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

/// Presente de aniversário já dado: um por cliente, lugar e ano (a restrição garante que o cron não repita).
model BirthdayGift {
  id           String   @id @default(uuid())
  customerId   String
  restaurantId String
  year         Int
  points       Int
  createdAt    DateTime @default(now())

  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([customerId, restaurantId, year])
}

model Booking {
  id                 String        @id @default(uuid())
  restaurantId       String
  unitId             String
  customerId         String? // vazio = encaixe feito pelo dono para quem não tem conta (guestName/guestPhone)
  guestName          String?
  guestPhone         String?
  createdBy          String? // OWNER quando o próprio lugar marcou
  serviceId          String?
  resourceId         String?
  startsAt           DateTime
  endsAt             DateTime
  status             BookingStatus @default(PENDING)
  // Cópias do que foi marcado, para o histórico não mudar se o serviço for editado ou removido.
  serviceName        String
  durationMin        Int
  priceCents         Int           @default(0)
  partySize          Int?
  note               String?
  pointsAwarded      Int           @default(0)
  pointsUsed         Int           @default(0) // pontos gastos como desconto neste agendamento (voltam se cancelar)
  discountCents      Int           @default(0) // desconto em R$ correspondente aos pontos usados
  claimId            String?       @unique // lançamento que creditou os pontos (ao concluir)
  clubSubscriptionId String? // atendimento coberto pelo plano do clube: não cobra, não dá pontos e abate do saldo do ciclo
  createdAt          DateTime      @default(now())
  confirmedAt        DateTime?
  completedAt        DateTime?
  canceledAt         DateTime?
  canceledBy         String? // CUSTOMER ou OWNER
  reminderSentAt     DateTime? // quando o "está tudo certo?" foi enviado
  reminderAnswer     String? // OK (confirmou presença) ou NO (liberou o horário); vazio = sem resposta
  reminderAnsweredAt DateTime?

  restaurant       Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service          Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  resource         Resource?         @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  claim            Claim?            @relation(fields: [claimId], references: [id], onDelete: SetNull)
  review           Review?
  clubSubscription ClubSubscription? @relation(fields: [clubSubscriptionId], references: [id], onDelete: SetNull)

  @@index([restaurantId, startsAt])
  @@index([customerId, startsAt])
  @@index([resourceId, startsAt])
  @@index([status, startsAt])
}

/// Contato de um comerciante interessado no Fidelize (veio pelo QR Code, pelo app do cliente ou pelo site). status = NEW | CONTACTED | WON | LOST.
model Lead {
  id            String    @id @default(uuid())
  name          String
  business      String
  phone         String
  email         String
  city          String
  state         String?
  category      String
  categoryOther String?
  message       String?
  source        String    @default("app")
  status        String    @default("NEW")
  emailSent     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  contactedAt   DateTime?

  @@index([status, createdAt])
}

/// Horário segurado por alguns minutos para quem está confirmando o agendamento: some da lista dos outros clientes até confirmar ou expirar.
model SlotHold {
  id           String   @id @default(uuid())
  restaurantId String
  unitId       String
  customerId   String
  resourceId   String
  startsAt     DateTime
  endsAt       DateTime
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  resource   Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  /// Cada cliente segura um horário por vez em cada lugar.
  @@unique([customerId, restaurantId])
  @@index([resourceId, expiresAt])
}

/// Folga, férias, almoço ou qualquer bloqueio: o horário some da agenda do cliente. resourceId vazio = vale para todos os profissionais.
model TimeOff {
  id           String   @id @default(uuid())
  restaurantId String
  unitId       String? // vazio = todas as unidades
  resourceId   String? // vazio = todos os profissionais
  startsAt     DateTime
  endsAt       DateTime
  reason       String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  resource   Resource?  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([restaurantId, startsAt])
  @@index([resourceId, startsAt])
}

enum WaitlistStatus {
  WAITING // esperando abrir um horário
  BOOKED // conseguiu marcar
  CANCELED // saiu da lista
}

/// Cliente que quer um dia que está lotado: quando um horário abre (cancelamento, remarcação, folga removida), os primeiros da fila são avisados.
model WaitlistEntry {
  id           String         @id @default(uuid())
  restaurantId String
  unitId       String
  customerId   String
  serviceId    String
  resourceId   String? // vazio = qualquer profissional
  date         String // AAAA-MM-DD (Brasília)
  period       String         @default("ANY") // ANY, MORNING (até 12h), AFTERNOON (12h às 18h) ou EVENING (a partir das 18h)
  status       WaitlistStatus @default(WAITING)
  notifiedAt   DateTime? // último aviso de horário aberto
  createdAt    DateTime       @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource   Resource?  @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  /// Um pedido por cliente, serviço e dia; entrar de novo reaproveita a mesma linha.
  @@unique([customerId, restaurantId, serviceId, date])
  @@index([restaurantId, date, status])
}

/// Avaliação de um atendimento concluído: nota do lugar (1 a 5), nota de quem atendeu (opcional) e comentário (opcional).
/// Uma por agendamento. O dono responde e pode denunciar; a administração decide se oculta (hiddenAt).
model Review {
  id             String    @id @default(uuid())
  restaurantId   String
  customerId     String
  bookingId      String    @unique
  resourceId     String? // quem atendeu (vazio se o atendimento não tinha profissional)
  placeRating    Int
  staffRating    Int?
  comment        String?
  ownerReply     String?
  ownerRepliedAt DateTime?
  reportedAt     DateTime? // o dono denunciou
  reportReason   String?
  hiddenAt       DateTime? // a administração ocultou: some do app e da nota
  createdAt      DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource   Resource?  @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([resourceId])
  @@index([reportedAt])
}

/// Indicação: o cliente posta a foto de um lugar onde tem carteira, com nota de 1 a 5 e um comentário.
model Post {
  id           String    @id @default(uuid())
  customerId   String
  restaurantId String
  rating       Int
  comment      String?
  hiddenAt     DateTime? // escondida pela administração (denúncia procedente)
  reportedAt   DateTime? // última denúncia recebida
  createdAt    DateTime  @default(now())

  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  photo      PostPhoto?
  likes      PostLike[]
  reports    PostReport[]

  @@index([createdAt])
  @@index([restaurantId, createdAt])
  @@index([customerId, createdAt])
  @@index([reportedAt])
}

/// A foto da indicação, em tabela própria (já reduzida no celular) para não pesar a lista.
model PostPhoto {
  postId String @id
  mime   String
  data   Bytes

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PostLike {
  postId     String
  customerId String
  createdAt  DateTime @default(now())

  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([postId, customerId])
  @@index([customerId])
}

/// Denúncia de uma indicação, feita por um cliente ou pelo dono do lugar citado.
model PostReport {
  id                   String   @id @default(uuid())
  postId               String
  reporterCustomerId   String?
  reporterRestaurantId String?
  reason               String
  createdAt            DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

/// Conversa entre um cliente e um estabelecimento (uma por par). As leituras guardam até quando cada lado já viu.
model Conversation {
  id               String    @id @default(uuid())
  customerId       String
  restaurantId     String
  lastMessageAt    DateTime  @default(now())
  customerReadAt   DateTime?
  restaurantReadAt DateTime?
  createdAt        DateTime  @default(now())

  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]

  @@unique([customerId, restaurantId])
  @@index([restaurantId, lastMessageAt])
  @@index([customerId, lastMessageAt])
}

/// Mensagem de texto. `sender` é CUSTOMER ou RESTAURANT.
model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  sender         String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Entrada ou despesa lançada pelo dono (gestão financeira). Fixas (`MONTHLY`) valem todo mês a partir de `date`, até `endsOn`.
/// As entradas de agenda, pedidos e caixa vêm dos próprios atendimentos e lançamentos; aqui ficam só as manuais e as do clube.
model FinanceEntry {
  id           String    @id @default(uuid())
  restaurantId String
  kind         String // IN (entrada) ou OUT (despesa)
  description  String
  category     String
  amountCents  Int
  date         DateTime  @db.Date
  recurrence   String    @default("NONE") // NONE ou MONTHLY
  endsOn       DateTime? @db.Date
  source       String    @default("MANUAL") // MANUAL ou CLUBE (pagamento de assinatura registrado pelo dono)
  refId        String?   @unique // origem automática (ex.: pagamento do clube), evita lançar duas vezes
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, date])
}

/// Comissão de um profissional já paga num mês ("AAAA-MM"). Conta como saída no financeiro e trava um segundo pagamento do mesmo mês.
model CommissionPayout {
  id           String   @id @default(uuid())
  restaurantId String
  resourceId   String?
  resourceName String
  month        String
  baseCents    Int
  commissionBp Int
  amountCents  Int
  paidAt       DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  resource   Resource?  @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@unique([resourceId, month])
  @@index([restaurantId, month])
}

/// Plano do clube de assinatura do estabelecimento (ex.: "3 cortes e 2 barbas por mês"), cobrado todo mês no balcão.
model ClubPlan {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  priceCents   Int // por mês
  active       Boolean  @default(true) // inativo = não aceita novos assinantes (quem já assina continua)
  createdAt    DateTime @default(now())

  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items         ClubPlanItem[]
  subscriptions ClubSubscription[]

  @@index([restaurantId, active])
}

/// O que o plano inclui por ciclo: quantas vezes de um serviço.
model ClubPlanItem {
  id        String @id @default(uuid())
  planId    String
  serviceId String
  quantity  Int // por ciclo mensal

  plan    ClubPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  service Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([planId, serviceId])
}

/// Assinatura de um cliente. O ciclo é mensal a partir de `anchorDate` (o dia do 1º pagamento) e cada pagamento registrado pelo
/// dono cobre mais um ciclo (`paidPeriods`). Cancelar só impede novas renovações: o que já foi pago vale até o fim do ciclo.
model ClubSubscription {
  id           String    @id @default(uuid())
  restaurantId String
  planId       String
  customerId   String
  status       String    @default("ACTIVE") // ACTIVE ou CANCELED
  anchorDate   DateTime? @db.Date // vazio até o primeiro pagamento
  paidPeriods  Int       @default(0)
  planName     String // cópia do nome e do preço no momento da assinatura
  priceCents   Int
  requestedBy  String // CUSTOMER (pediu pelo app) ou OWNER (o lugar cadastrou)
  canceledAt   DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan       ClubPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings   Booking[]

  @@index([restaurantId, status])
  @@index([customerId])
}
