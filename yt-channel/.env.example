# Roteiro e verificação de fatos (obrigatório)
ANTHROPIC_API_KEY=

# Contato exigido pela política da Wikimedia no User-Agent (e-mail ou URL do canal)
WIKI_CONTACT=

# Upload no YouTube (rode scripts/get_refresh_token.py uma vez para obter o refresh token)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Ilustrações de IA quando não houver imagem livre no Wikimedia Commons (opcional, pago)
MUAPI_API_KEY=
