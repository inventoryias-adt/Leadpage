# ---------------------------------------------------------------------------
# Sports Operator - variaveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local (ja esta no .gitignore).
# ---------------------------------------------------------------------------

# Provider de odds a ser usado: "demo" ou "theoddsapi"
# Se ODDS_PROVIDER nao for definido ou a API key nao existir, o sistema cai
# automaticamente em modo DEMO (dados ficticios, claramente identificados na UI).
ODDS_PROVIDER=demo

# Chave da API https://the-odds-api.com/ (necessaria apenas se ODDS_PROVIDER=theoddsapi)
# NUNCA exponha esta chave no frontend - ela e usada somente em app/api/* (backend).
THE_ODDS_API_KEY=

# Regiao de bookmakers usada nas consultas da The Odds API (eu, uk, us, au)
ODDS_REGION=eu

# Caminho do banco SQLite local (relativo a raiz do projeto).
# Usado apenas quando DATABASE_URL (abaixo) NAO estiver definida.
DATABASE_PATH=./data/sports-operator.db

# Connection string do Postgres (Supabase) para PRODUCAO.
# Se definida, a aplicacao usa Postgres em vez de SQLite (ver lib/db/index.ts).
# Deixe em branco para desenvolvimento local (usa SQLite automaticamente).
# Formato (Supabase -> Project Settings -> Database -> Connection string -> URI,
# modo "Transaction pooler", porta 6543):
# postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
